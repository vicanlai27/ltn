# Copy this file to .env for local development, and set the same names
# (with real values) as Environment Variables in the Vercel dashboard for
# production. See DEPLOYMENT.md for where each value comes from.

# --- Flask -------------------------------------------------------------
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
SESSION_HASH_SALT=change-me-too-rotate-periodically

# --- Database (Supabase Postgres) ---------------------------------------
# Local dev: leave unset to fall back to a local SQLite file at
# instance/lavisco.db. To develop against Supabase instead (recommended
# once you're testing storage/production behavior), set this to your
# Supabase "Connection string" (URI) from
# Project Settings -> Database -> Connection string -> URI.
#
# In production on Vercel, use the "Transaction pooler" connection string
# (port 6543) instead of the direct connection (port 5432) -- serverless
# functions open/close connections constantly, and the pooler is built for
# exactly that. Direct connections will hit Supabase's connection-limit
# ceiling under real traffic.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Storage (Supabase Storage) -----------------------------------------
# Project Settings -> API -> Project URL / service_role key.
# The service_role key bypasses Row Level Security -- keep it server-side
# only (Vercel env var), never expose it to the browser or commit it.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

# --- Mail (optional, transactional only) --------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@lavisco.news
MAIL_USE_TLS=1

# --- Lavisco TV (YouTube indexing, optional) ----------------------------
YOUTUBE_CHANNEL_HANDLE=@LAVISCOTV-bm1mp
YOUTUBE_CHANNEL_ID=

# --- Misc ----------------------------------------------------------------
SITE_TIMEZONE=Africa/Kampala
